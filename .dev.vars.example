# Told You So — environment variables (example)
# Keep real secrets in .dev.vars (git-ignored) and as Worker secrets. Never commit real values.

# AI
GEMINI_API_KEY=
GEMINI_DAILY_CAP=60

# Supabase (server — service role key must NEVER be NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase (browser — anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integrations
NOTION_TOKEN=
NOTION_DATABASE_ID=
RESEND_API_KEY=
RESEND_FROM=
RESEND_OWNER_EMAIL=

# Auth / crons
CRON_SECRET=
ALLOWED_EMAILS=

# Feature flags
FLAG_CONFIDENCE=false
FLAG_FINTECH=false
FLAG_LOG_VERDICTS=false
NEXT_PUBLIC_FLAG_POLITE_CARDS=false
FLAG_VERIFY_EXTRACTION=true
