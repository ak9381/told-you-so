{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "told-you-so",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["* * * * *", "30 3 * * MON"]
  }
}
